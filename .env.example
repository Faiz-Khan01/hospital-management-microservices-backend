# ==========================================
# Hospital Management System - Environment Variables
# ==========================================

# Security / JWT
JWT_SECRET=HospitalSyncSecretKey2026SecureJwtSigningKeyString

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Password

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Discovery (Eureka)
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# API Gateway
GATEWAY_PORT=8080
