# ==============================================================================
# HospitalSync Pro Suite - Environment Configuration Template (.env.example)
# ==============================================================================
#
# IMPORTANT FOR PRODUCTION:
# 1. DO NOT commit your actual `.env` file to version control.
# 2. To generate cryptographically secure production keys, run:
#      PowerShell:  .\scripts\generate-production-secrets.ps1
#      Bash/Linux:  ./scripts/generate-production-secrets.sh
# 3. For Kubernetes / Cloud: Inject these as Kubernetes Secrets or AWS Secrets Manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & JWT (P0)
# ------------------------------------------------------------------------------
# Minimum 256-bit (32+ chars) cryptographically secure secret key for HS256 signing
JWT_SECRET=HospitalSyncSecretKey2026SecureJwtSigningKeyString
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
# In production, use a strong password with at least 24 characters (letters, numbers, symbols)
DB_PASSWORD=Password

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Change immediately upon initial boot
ADMIN_EMAIL=admin@hospitalsync.com
ADMIN_PASSWORD=admin123

# ------------------------------------------------------------------------------
# 4. CACHE & MESSAGING
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. SERVICE DISCOVERY & GATEWAY
# ------------------------------------------------------------------------------
EUREKA_SERVER_URL=http://naming-server:8761/eureka/
GATEWAY_PORT=8080

# ------------------------------------------------------------------------------
# 6. SSL / TLS CONFIGURATION (HTTPS)
# ------------------------------------------------------------------------------
# For direct Spring Boot SSL (if Nginx reverse proxy is not terminating TLS)
SSL_ENABLED=false
SSL_KEY_STORE_PATH=/certs/keystore.p12
SSL_KEY_STORE_PASSWORD=KeystorePasswordHere
SSL_KEY_STORE_TYPE=PKCS12

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & METRICS
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
PROMETHEUS_METRICS_EXPORT_ENABLED=true
