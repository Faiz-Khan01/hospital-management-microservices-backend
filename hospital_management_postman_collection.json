            "body": { "mode": "raw", "raw": "{\"name\": \"Ravi Kumar\", \"age\": 45, \"gender\": \"Male\", \"contact\": \"9876543210\", \"disease\": \"Hypertension\"}" }
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
