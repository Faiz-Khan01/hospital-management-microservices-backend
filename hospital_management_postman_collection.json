{
  "info": {
    "name": "HospitalSync — Full API Test Suite",
    "description": "Comprehensive API collection for Hospital Management Microservices. All requests route through API Gateway at http://localhost:8080",
    "_postman_id": "hospital-mgmt-v2-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:8080", "type": "string" },
    { "key": "TOKEN", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/register", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\"username\": \"testdoctor\", \"email\": \"doctor@hospital.com\", \"password\": \"Doctor@123\", \"role\": \"DOCTOR\"}" }
          }
        },
        {
          "name": "Login (Get JWT Token)",
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json(); if (json.token) { pm.collectionVariables.set('TOKEN', json.token); pm.test('Token received', () => pm.expect(json.token).to.be.a('string')); }"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/login", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\"username\": \"admin\", \"password\": \"admin123\"}" }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/me", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/forgot-password", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "auth", "forgot-password"] },
            "body": { "mode": "raw", "raw": "{\"email\": \"doctor@hospital.com\"}" }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": { "raw": "{{BASE_URL}}/api/v1/auth/change-password", "host": ["{{BASE_URL}}"], "path": ["api", "v1", "auth", "change-password"] },
            "body": { "mode": "raw", "raw": "{\"oldPassword\": \"admin123\", \"newPassword\": \"Admin@456\"}" }
          }
        }
      ]
    },
    {
      "name": "2. Patients",
      "item": [
        {
          "name": "Get All Patients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
